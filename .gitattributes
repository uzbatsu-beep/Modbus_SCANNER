# Normalize line endings in the repository, check out natively on each platform.
* text=auto

# Source files — always LF in the repository.
*.rs      text eol=lf
*.ts      text eol=lf
*.vue     text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.html    text eol=lf
*.svg     text eol=lf

# Windows-specific scripts must stay CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary assets (never normalize).
*.png     binary
*.ico     binary
*.icns    binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.pdf     binary
*.dll     binary
*.exe     binary
